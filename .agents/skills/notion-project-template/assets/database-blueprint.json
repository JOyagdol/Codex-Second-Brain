{
  "databases": {
    "Projects": {
      "title": "Projects",
      "title_property": "Project",
      "schema": "CREATE TABLE (\"Project\" TITLE, \"Created\" CREATED_TIME, \"Last Updated\" LAST_EDITED_TIME, \"Owner\" PEOPLE, \"Start\" DATE, \"Status\" SELECT('Planning':gray, 'Active':blue, 'On Hold':yellow, 'Completed':green, 'Archived':brown), \"Target Date\" DATE)"
    },
    "Tasks": {
      "title": "Tasks",
      "title_property": "Task",
      "schema": "CREATE TABLE (\"Task\" TITLE, \"Area\" SELECT('Planning':brown, 'Frontend':blue, 'Backend':green, 'Database':purple, 'AI':pink, 'Design':orange, 'Infra':gray, 'Business':yellow), \"Assignee\" PEOPLE, \"Created\" CREATED_TIME, \"Due Date\" DATE, \"Estimate\" NUMBER, \"GitHub\" URL, \"Last Updated\" LAST_EDITED_TIME, \"Priority\" SELECT('Critical':red, 'High':orange, 'Medium':yellow, 'Low':green), \"Start Date\" DATE, \"Status\" SELECT('Backlog':gray, 'Todo':default, 'In Progress':blue, 'Review':yellow, 'Done':green, 'Blocked':red), \"Type\" SELECT('Epic':purple, 'Feature':blue, 'Task':default, 'Bug':red, 'Research':green, 'Design':pink, 'Documentation':gray), \"ID\" UNIQUE_ID PREFIX 'TASK')"
    },
    "Sprints": {
      "title": "Sprints",
      "title_property": "Sprint",
      "schema": "CREATE TABLE (\"Sprint\" TITLE, \"Created\" CREATED_TIME, \"End\" DATE, \"Goal\" RICH_TEXT, \"Last Updated\" LAST_EDITED_TIME, \"Start\" DATE, \"Status\" SELECT('Planning':gray, 'Active':blue, 'Completed':green, 'Cancelled':red))"
    },
    "Requirements": {
      "title": "Requirements",
      "title_property": "Requirement",
      "schema": "CREATE TABLE (\"Requirement\" TITLE, \"Area\" MULTI_SELECT('Planning':brown, 'Frontend':blue, 'Backend':green, 'Database':purple, 'AI':pink, 'Design':orange, 'Infra':gray, 'Business':yellow), \"Created\" CREATED_TIME, \"Description\" RICH_TEXT, \"Last Updated\" LAST_EDITED_TIME, \"Owner\" PEOPLE, \"Priority\" SELECT('Critical':red, 'High':orange, 'Medium':yellow, 'Low':green), \"Status\" SELECT('Idea':gray, 'Review':yellow, 'Approved':blue, 'In Development':purple, 'Implemented':green, 'Rejected':red), \"Type\" SELECT('Idea':gray, 'Functional Requirement':blue, 'Non-functional Requirement':purple, 'Business Requirement':yellow, 'Technical Requirement':green), \"ID\" UNIQUE_ID PREFIX 'REQ')"
    },
    "Meetings": {
      "title": "Meetings",
      "title_property": "Meeting",
      "schema": "CREATE TABLE (\"Meeting\" TITLE, \"Created\" CREATED_TIME, \"Date\" DATE, \"Last Updated\" LAST_EDITED_TIME, \"Participants\" PEOPLE, \"Summary\" RICH_TEXT, \"Type\" SELECT('Weekly':blue, 'Planning':yellow, 'Development':green, 'Design':pink, 'Review':purple, 'Ad hoc':orange, 'Template':gray))"
    },
    "Documents": {
      "title": "Documents",
      "title_property": "Document",
      "schema": "CREATE TABLE (\"Document\" TITLE, \"Area\" MULTI_SELECT('Planning':brown, 'Frontend':blue, 'Backend':green, 'Database':purple, 'AI':pink, 'Design':orange, 'Infra':gray, 'Business':yellow, 'General':default), \"Category\" SELECT('Planning':brown, 'Requirement Spec':yellow, 'Architecture':blue, 'Frontend':blue, 'Backend':green, 'Database':purple, 'API':orange, 'QA':red, 'Version Control':gray, 'Deployment':green, 'Infrastructure':gray, 'AI Prompt':pink, 'AI Skill':purple, 'Design Guide':orange, 'Business':yellow, 'Research':blue, 'Guide':default), \"Created\" CREATED_TIME, \"Last Reviewed\" DATE, \"Last Updated\" LAST_EDITED_TIME, \"Owner\" PEOPLE, \"Status\" SELECT('Draft':gray, 'In Review':yellow, 'Approved':blue, 'Final':green, 'Deprecated':red), \"Version\" RICH_TEXT, \"ID\" UNIQUE_ID PREFIX 'DOC')"
    },
    "Resources": {
      "title": "Resources",
      "title_property": "Resource",
      "schema": "CREATE TABLE (\"Resource\" TITLE, \"Added By\" PEOPLE, \"Added Date\" CREATED_TIME, \"Area\" MULTI_SELECT('Frontend':blue, 'Backend':green, 'Database':purple, 'AI':pink, 'DevOps':gray, 'Design':orange, 'Business':yellow, 'Planning':brown, 'General':default), \"Last Updated\" LAST_EDITED_TIME, \"Role\" SELECT('Workspace':blue, 'Reference':purple, 'Learning':green), \"Source\" RICH_TEXT, \"Status\" SELECT('Active':blue, 'To Read':gray, 'Reading':yellow, 'Reviewed':green, 'Important':red, 'Archived':brown), \"Summary\" RICH_TEXT, \"Topic\" MULTI_SELECT(), \"Type\" SELECT('GitHub':gray, 'Figma':pink, 'Swagger':green, 'ERD':purple, 'Diagram':blue, 'Server':orange, 'API':yellow, 'Notion':default, 'Drive':blue, 'Article':yellow, 'Blog':orange, 'Documentation':blue, 'Paper':purple, 'Book':brown, 'Course':green, 'Video':red, 'Repository':gray, 'Library / Framework':pink, 'Tool':default, 'Example Project':green, 'Reference':purple, 'Other':gray), \"URL\" URL)"
    }
  },
